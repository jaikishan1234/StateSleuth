# Copy to .env.local and fill in only the provider you want to use.
#
# Providers: gemini | groq | openrouter
# Every variable is optional. With no key set, /planner uses demo mode and
# coding proposals use the clearly labelled fixture. No network call is made.
#
# Precedence (first value that is set wins):
#   provider: <AGENT>_PROVIDER  -> MODEL_PROVIDER      -> gemini
#   model:    <AGENT>_MODEL     -> provider default
#   base URL: <AGENT>_BASE_URL  -> provider default
#   API key:  <AGENT>_API_KEY   -> <PROVIDER>_API_KEY  -> MODEL_API_KEY
#   output:   <AGENT>_MAX_OUTPUT_TOKENS -> agent default (planner 1600, coding 4000)
#
# <AGENT> is PLANNER or CODING. The two agents are independent, so the planner
# can use Gemini while the coding agent uses Groq or OpenRouter.
#
# Provider defaults:
#   gemini      https://generativelanguage.googleapis.com/v1beta/openai
#               gemini-3.8-flash            key: GEMINI_API_KEY
#   groq        https://api.groq.com/openai/v1
#               llama-3.3-70b-versatile     key: GROQ_API_KEY
#   openrouter  https://openrouter.ai/api/v1
#               openai/gpt-4o-mini          key: OPENROUTER_API_KEY

# Planner agent
PLANNER_PROVIDER=
PLANNER_MODEL=
PLANNER_API_KEY=
PLANNER_BASE_URL=
# Optional output-token budget for plans (default 1600)
PLANNER_MAX_OUTPUT_TOKENS=
# Optional request deadline in ms, headers plus body (default 90000, range 5000-300000)
PLANNER_TIMEOUT_MS=

# Coding agent
CODING_PROVIDER=
CODING_MODEL=
CODING_API_KEY=
CODING_BASE_URL=
# Optional output-token budget for diffs (default 4000)
CODING_MAX_OUTPUT_TOKENS=

# Shared defaults
MODEL_PROVIDER=
MODEL_API_KEY=

# Provider-wide keys, used when the agent-specific key is absent
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=