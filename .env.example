# Copy to .env.local and fill in a key to enable live planning.
# Without a key, /planner runs in clearly labelled demo mode.
#
# Any OpenAI-compatible chat completions endpoint works. For OpenRouter, Groq,
# Together, a local gateway or Ollama's OpenAI-compatible endpoint, change
# PLANNER_BASE_URL to that provider's /v1 URL.

PLANNER_API_KEY=
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini